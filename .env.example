# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Google Keep is protected by a same-origin check on /api/google-keep — no
# extra API key required. Google credentials live in your OS keyring, set up
# via: cd scripts && python3 google_keep.py setup
# See docs/google-keep-setup.md.

# Anthropic API key for "Import from URL" recipe extraction.
# Server-only. Create one at https://console.anthropic.com/
# Optional — without it, the import endpoint can still parse pages
# that expose Schema.org Recipe JSON-LD (most major recipe sites).
ANTHROPIC_API_KEY=
