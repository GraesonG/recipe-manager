# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Google Keep API Protection
# Generate a random key with: openssl rand -base64 32
# This key must be set on both server and client side
GKEEP_API_KEY=your-secret-key-here
NEXT_PUBLIC_GKEEP_API_KEY=your-secret-key-here

# Anthropic API key for "Import from URL" recipe extraction.
# Server-only. Create one at https://console.anthropic.com/
# Optional — without it, the import endpoint can still parse pages
# that expose Schema.org Recipe JSON-LD (most major recipe sites).
ANTHROPIC_API_KEY=
